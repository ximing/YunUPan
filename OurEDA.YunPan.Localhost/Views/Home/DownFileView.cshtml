@model OurEDA.YunPan.Localhost.Models.FileStore
@{
    Layout = null;
}

<!doctype html>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=10,IE=9" />
    <meta name="renderer" content="webkit" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="baidu-site-verification" content="qV4HG09G0S" />
    <script src="~/Scripts/jquery-1.8.2.min.js"></script>
    <script src="~/js/download.js"></script>
    <link href="~/css/bootstrap.min.css" type="text/css" rel="stylesheet">
    <link href="~/css/index.css" type="text/css" rel="stylesheet">
    <!--<link href="http://1.oureda.sinaapp.com/chirs.css" type="text/css" rel="stylesheet">-->
    <title>OurEDA微云盘</title>
</head>

<body>
    <div class="navbar-default header" role="banner">
        <div class="container">
            <div class="navbar-header">
                <button class="navbar-toggle" type="button" data-toggle="collapse" data-target=".bs-navbar-collapse"> <span class="sr-only">Click</span> <span class="icon-bar"></span> <span class="icon-bar"></span> <span class="icon-bar"></span> </button>
                <a href="http://upan.oureda.cn/" class="navbar-brand"><i class="glyphicon-cloud glyphicon"></i>OurEDA</a>
            </div>
            <nav class="collapse navbar-collapse bs-navbar-collapse" role="navigation">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="http://upan.oureda.cn/" title="点击回到首页">首页</a> </li>
                    <li><a href="~/Home/Introduce" title="如何在微云盘上传、下载、遇到问题怎么办？">相关介绍</a> </li>
                    <li><a href="http://vteacher.oureda.net/" target="_blank" title="校内文件资源第一站">V-Teacher</a> </li>
                </ul>
            </nav>
        </div>
    </div>
    <div class="container">
        <div class="ad">
            <img src="~/image/logo.gif" style="float: left; margin-right: 5%;">
            <div class="adword">
                <p>忘带U盘？怕中木马？互传文件传的好慢？</p>
                <p class="second-line">随时上传，随地下载，短短四位，用提取码下载文件</p>
            </div>
        </div>
        <div class="miniad">
            <p style="font-size: 1.5em;">忘带U盘？怕中木马？</p>
            <p style="font-size: 1.5em;">互传文件传的好慢？</p>
            <p style="font-size: 1.25em;margin-top:3em;">暂不支持移动版和平板电脑，快快换成电脑吧！</p>
        </div>
        <div class="center" id="target_box">
            <form class="form-inline" action="/Home/DownFileByrandName" role="form" style="margin-left:100px;margin-top:80px;">
                <div class="form-group">
                    <label class="sr-only" for="key">在这里输入提取码</label>
                    <input value="@TempData["randName"]" type="text" name="randName" class="form-control col-lg-4" id="key" placeholder="在这里输入提取码">
                </div>
                <input type="submit" class="btn btn-primary" value="点击提取文件">
            </form>
            <div class="suggest" style="margin-top:50px;">
                <p>*现在左边的框框输入提取码，再点击确定就ok啦</p>
                <p id="warning">@TempData["error"]</p>
                <p id="success"></p>
            </div>
            <div class="upword">
                <a href="http://upan.oureda.cn/"><i class="glyphicon glyphicon-hand-left"></i><span>去上传</span></a>
            </div>
        </div>
    </div>

    <div class="myfooter">
        <p>
            <a href="http://www.oureda.cn/">OurEDA</a>　<small>Copyright © 2013-2014</small>
            <script type="text/javascript">var cnzz_protocol = (("https:" == document.location.protocol) ? " https://" : " http://"); document.write(unescape("%3Cspan id='cnzz_stat_icon_1000186673'%3E%3C/span%3E%3Cscript src='" + cnzz_protocol + "s22.cnzz.com/z_stat.php%3Fid%3D1000186673%26show%3Dpic' type='text/javascript'%3E%3C/script%3E"));</script>
        </p>
        <address>大连理工大学 · 国家示范性软件学院综合楼4层</address>
    </div>
</body>
</html>
